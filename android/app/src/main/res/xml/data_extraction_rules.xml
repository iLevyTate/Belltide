<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer. See backup_rules.xml for why these files are left out. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="belltide_engine.xml" />
        <exclude domain="sharedpref" path="belltide_clickup.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="belltide_engine.xml" />
        <exclude domain="sharedpref" path="belltide_clickup.xml" />
    </device-transfer>
</data-extraction-rules>
